{
  "expo": {
    "name": "SecureVault",
    "slug": "secure-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "securevault",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naderalfakesh.securevault",
      "buildNumber": "1",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#3451D1"
      },
      "package": "com.naderalfakesh.securevault",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withSecureVault.js",
      "./plugins/withMlkitSimulatorFix",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 72,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6FA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0A0D1A"
          }
        }
      ],
      "expo-status-bar",
      "expo-image",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      "./plugins/withSqlCipherOpenSsl.js",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    }
  }
}
